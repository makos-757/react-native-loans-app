# ===========================================================================
# Vaultiline — Environment
# ===========================================================================
# Copy this file to backend/worker/.dev.vars for LOCAL development.
# For production, set non-secret values in wrangler.toml [vars] and
# secrets with `wrangler secret put`.
# ---------------------------------------------------------------------------

# --- M-Pesa (Safaricom Daraja) Credentials ---------------------------
# From the Daraja portal: https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=PASTE_YOUR_DARAJA_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=PASTE_YOUR_PASSKEY
MPESA_INITIATOR_NAME=YOUR_INITIATOR_NAME
MPESA_INITIATOR_PASSWORD=PASTE_YOUR_INITIATOR_PASSWORD
MPESA_CALLBACK_TOKEN=PASTE_A_RANDOM_CALLBACK_TOKEN

# --- M-Pesa Environment -----------------------------------------------
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_PARTY_BF=YOUR_SHORTCODE
MPESA_QUEUE_TIMEOUT_URL=https://sandbox.safaricom.co.ke/mpesa/queue
MPESA_RESULT_URL=https://sandbox.safaricom.co.ke/mpesa/result
MPESA_CALLBACK_URL=http://localhost:8787/api/mpesa/callback
MPESA_ACCOUNT_REFERENCE=VAULTILINE

# --- Africa's Talking (SMS OTP) ---------------------------------------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=YOUR_API_KEY

# --- Email OTP (Brevo) -------------------------------------------------
BREVO_API_KEY=YOUR_BREVO_API_KEY
EMAIL_FROM=noreply@example.com
